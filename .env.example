# Copy to .env and fill in. These are read on the server only (api/chat.ts and
# the Vite dev middleware) and must never be prefixed with VITE_.
#
# Any OpenAI-compatible chat-completions endpoint works. Groq example:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
